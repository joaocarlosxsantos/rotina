# Valores configurados pelo dono fora do Git. Vazio usa SQLite local em dev/test.
# Na Vercel, basta conectar o Turso ao projeto em Production: a integração injeta TURSO_DATABASE_URL e TURSO_AUTH_TOKEN.
# Se usar variáveis manuais, configure DATABASE_URL/DATABASE_AUTH_TOKEN. Quando os dois pares existem, DATABASE_* vence.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
